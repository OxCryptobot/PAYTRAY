{
  "name": "paytray",
  "version": "0.1.0",
  "private": true,
  "description": "PayTray - AI expert discovery, real-time communication, and blockchain payments",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=18 <25"
  },
  "scripts": {
    "backend:start": "npm run start --workspace=@paytray/backend",
    "backend:dev": "npm run dev --workspace=@paytray/backend",
    "backend:test": "npm run test --workspace=@paytray/backend",
    "backend:lint": "npm run lint --workspace=@paytray/backend",
    "backend:migrations:check": "node packages/backend/scripts/verify-migrations.mjs",
    "backend:deployment:check": "node packages/backend/scripts/verify-deployment-preflight.mjs",
    "backend:railway:trial:check": "node packages/backend/scripts/verify-railway-trial.mjs",
    "backend:release:approval:check": "node packages/backend/scripts/inspect-release-approval.mjs",
    "backend:release:manifest:check": "node packages/backend/scripts/inspect-release-manifest.mjs",
    "start": "npm run backend:start",
    "test": "npm run backend:test",
    "lint": "npm run backend:lint"
  },
  "workspaces": {
    "packages": [
      "packages/backend"
    ]
  }
}
